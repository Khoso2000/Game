rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidEntry(data) {
      return data.keys().hasAll(['id', 'playerName', 'score', 'linesCleared', 'maxCombo', 'dateKey', 'userId']) &&
             data.keys().hasOnly(['id', 'playerName', 'score', 'linesCleared', 'maxCombo', 'dateKey', 'userId', 'createdAt']) &&
             data.id is string && data.id.size() <= 128 &&
             data.playerName is string && data.playerName.size() >= 1 && data.playerName.size() <= 30 &&
             data.score is number && data.score >= 0 && data.score <= 1000000 &&
             data.linesCleared is number && data.linesCleared >= 0 &&
             data.maxCombo is number && data.maxCombo >= 0 &&
             data.dateKey is string && data.dateKey.size() <= 10 &&
             data.userId is string && data.userId.size() <= 128;
    }

    match /daily_leaderboard/{entryId} {
      // Anyone can read/list daily leaderboard scores
      allow read: if true;

      // Allow creating a new score entry if valid
      allow create: if isValidId(entryId) &&
                       isValidEntry(incoming()) &&
                       incoming().id == entryId;

      // Prevent updating or deleting existing entries to preserve leaderboard integrity
      allow update, delete: if false;
    }
  }
}
